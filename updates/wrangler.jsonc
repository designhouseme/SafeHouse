// The update host Worker: https://updates.designhouse.me/shouse/… from the private R2 bucket shouse-updates.
// Deploy: cd updates && npx wrangler deploy   (needs `npx wrangler login` on the account that owns designhouse.me)
{
	"name": "shouse-updates",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "updates.designhouse.me", "custom_domain": true }],
	"r2_buckets": [{ "binding": "UPDATES", "bucket_name": "shouse-updates" }],
	"observability": { "enabled": true }
}

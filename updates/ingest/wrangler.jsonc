// Upload endpoint for the R2 bucket shouse-updates, two tokens with separate files (see src/index.js):
//   INGEST_TOKEN   = SHOUSE_INGEST_TOKEN in designhouseme/SafeHouseCVE (vulnerability data);
//   RELEASE_TOKEN  = SHOUSE_RELEASE_TOKEN in the "release" environment of designhouseme/SafeHouse (release files).
// Deploy: cd updates/ingest && npx wrangler deploy; set or rotate a token: npx wrangler secret put <NAME>.
{
	"name": "shouse-ingest",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "shouse-ingest.designhouse.me", "custom_domain": true }],
	"r2_buckets": [{ "binding": "UPDATES", "bucket_name": "shouse-updates" }],
	"observability": { "enabled": true }
}

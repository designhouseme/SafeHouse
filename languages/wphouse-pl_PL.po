msgid "Security"
msgstr "Bezpieczeństwo"

#. translators: 1: number of critical findings, 2: number of warnings.
#: src/Modules/PluginHealth.php:351
#, php-format
msgid "%1$d critical, %2$d warnings. Details are on the WPHouse settings page."
msgstr "Krytyczne: %1$d, ostrzeżenia: %2$d. Szczegóły na stronie ustawień WPHouse."

#: src/Modules/PluginHealth.php:356
msgid "Open WPHouse"
msgstr "Otwórz WPHouse"

#: src/Modules/PluginHealth.php:362
#: src/Modules/Vulnerabilities.php:311
#: src/Modules/Watch.php:238
msgid "Check now"
msgstr "Sprawdź teraz"

#. translators: %s: error message.
#: src/Modules/PluginHealth.php:369
#, php-format
msgid "Could not reach WordPress.org: %s"
msgstr "Nie udało się połączyć z WordPress.org: %s"

#: src/Modules/PluginHealth.php:370
msgid "Plugin health updated."
msgstr "Kondycja wtyczek zaktualizowana."

#: src/Modules/PluginHealth.php:377
msgid "Not checked yet. Use \"Check now\" or wait for the daily run."
msgstr "Jeszcze nie sprawdzono. Kliknij „Sprawdź teraz” albo poczekaj na codzienne sprawdzenie."

#. translators: %s: date and time.
#: src/Modules/PluginHealth.php:381
#: src/Modules/Vulnerabilities.php:330
#, php-format
msgid "Last check: %s."
msgstr "Ostatnie sprawdzenie: %s."

#. translators: %s: error message.
#: src/Modules/PluginHealth.php:383
#, php-format
msgid "The last refresh failed: %s"
msgstr "Ostatnie odświeżenie nie powiodło się: %s"

#: src/Modules/PluginHealth.php:388
msgid "Nothing to report."
msgstr "Brak uwag."

#: src/Modules/PluginHealth.php:391
msgid "Plugin"
msgstr "Wtyczka"

#: src/Modules/PluginHealth.php:391
msgid "Findings"
msgstr "Wyniki"

#: src/Admin/Page.php:454
#: src/Modules/PluginHealth.php:393
msgid "inactive"
msgstr "nieaktywna"

#: src/Modules/Scripts.php:39
msgid "Header and footer scripts"
msgstr "Skrypty w nagłówku i stopce"

#: src/Modules/Scripts.php:43
msgid "Adds tracking codes, verification tags and widgets to every front-end page. HTML and JavaScript only, never PHP. Only administrators who may post unfiltered HTML can edit them."
msgstr "Dodaje kody śledzące, tagi weryfikacyjne i widżety do każdej strony witryny. Tylko HTML i JavaScript, nigdy PHP. Edytować je mogą wyłącznie administratorzy z uprawnieniem do niefiltrowanego HTML."

#: src/Modules/Scripts.php:50
msgid "In <head>"
msgstr "W <head>"

#: src/Modules/Scripts.php:51
msgid "Printed early in <head>. Google Tag Manager, analytics, verification meta tags."
msgstr "Wstawiane na początku <head>. Google Tag Manager, analityka, tagi meta weryfikacji."

#: src/Modules/Scripts.php:56
msgid "After <body>"
msgstr "Po <body>"

#: src/Modules/Scripts.php:57
msgid "Needs a theme that calls wp_body_open() (all current themes do). GTM noscript iframe."
msgstr "Wymaga motywu wywołującego wp_body_open() (robią to wszystkie aktualne motywy). Ramka noscript GTM."

#: src/Modules/Scripts.php:62
msgid "Before </body>"
msgstr "Przed </body>"

#: src/Modules/Scripts.php:63
msgid "Chat widgets, pixels and other scripts that can load last."
msgstr "Widżety czatu, piksele i inne skrypty, które mogą ładować się na końcu."

#: src/Modules/Scripts.php:68
msgid "Do not output for logged-in administrators"
msgstr "Nie wstawiaj dla zalogowanych administratorów"

#: src/Modules/Scripts.php:69
msgid "Keeps your own visits out of analytics."
msgstr "Twoje własne wizyty nie trafią do statystyk."

#: src/Modules/Scripts.php:79
msgid "DISALLOW_UNFILTERED_HTML is set in wp-config.php, so nobody may add raw scripts."
msgstr "W wp-config.php ustawiono DISALLOW_UNFILTERED_HTML, więc nikt nie może dodawać surowych skryptów."

#: src/Modules/Smtp.php:40
msgid "SMTP mail"
msgstr "Poczta SMTP"

#: src/Modules/Smtp.php:44
msgid "Sends all WordPress and WooCommerce mail through your SMTP server, with credentials kept in wp-config.php. No mail log, so password-reset links are never stored."
msgstr "Wysyła całą pocztę WordPressa i WooCommerce przez Twój serwer SMTP, z danymi logowania w wp-config.php. Bez dziennika wiadomości, więc linki do resetu hasła nigdzie nie są zapisywane."

#: src/Modules/Smtp.php:51
msgid "From address"
msgstr "Adres nadawcy"

#: src/Modules/Smtp.php:52
msgid "Used when the sender is not set otherwise (WooCommerce sets its own). Should be on a domain your SMTP server may send for."
msgstr "Używany, gdy nadawca nie jest ustawiony inaczej (WooCommerce ustawia własnego). Powinien należeć do domeny, z której Twój serwer SMTP może wysyłać."

#: src/Modules/Smtp.php:57
msgid "From name"
msgstr "Nazwa nadawcy"

#: src/Modules/Smtp.php:129
msgid "Send a test e-mail to me"
msgstr "Wyślij do mnie testowy e-mail"

#: src/Modules/Smtp.php:141
msgid "WPHouse test e-mail"
msgstr "Testowy e-mail WPHouse"

#: src/Modules/Smtp.php:142
msgid "If you can read this, WordPress can send mail."
msgstr "Jeśli to czytasz, WordPress potrafi wysyłać pocztę."

#. translators: %s: e-mail address.
#: src/Modules/Smtp.php:148
#, php-format
msgid "Test e-mail sent to %s."
msgstr "Testowy e-mail wysłany na adres %s."

#. translators: %s: error message.
#: src/Modules/Smtp.php:151
#, php-format
msgid "Sending failed: %s"
msgstr "Wysyłka nie powiodła się: %s"

#. translators: %s: error message.
#: src/Modules/Smtp.php:151
msgid "unknown error"
msgstr "nieznany błąd"

#: src/Modules/Smtp.php:157
msgid "with login"
msgstr "z logowaniem"

#: src/Modules/Smtp.php:157
msgid "without login"
msgstr "bez logowania"

#. translators: 1: SMTP host, 2: port, 3: "with login" or "without login".
#: src/Modules/Smtp.php:160
#, php-format
msgid "SMTP: %1$s:%2$d, %3$s (from wp-config.php)."
msgstr "SMTP: %1$s:%2$d, %3$s (z wp-config.php)."

#: src/Modules/Smtp.php:162
msgid "SMTP is not configured: add WPHOUSE_SMTP_HOST (and port, user, password) to wp-config.php. Until then mail goes through PHP mail(); the From settings still apply."
msgstr "SMTP nie jest skonfigurowany: dodaj WPHOUSE_SMTP_HOST (oraz port, użytkownika i hasło) do wp-config.php. Do tego czasu poczta idzie przez PHP mail(); ustawienia nadawcy nadal działają."

#: src/Modules/Tweaks.php:35
msgid "Tweaks"
msgstr "Usprawnienia"

#: src/Modules/Tweaks.php:39
msgid "Small switches that are usually a plugin each: comments, search, emojis, embeds, head clean-up, Heartbeat, self-pingbacks and revision limits."
msgstr "Drobne przełączniki, z których każdy to zwykle osobna wtyczka: komentarze, wyszukiwarka, emoji, osadzanie, porządki w <head>, Heartbeat, pingbacki do siebie i limit wersji."

#: src/Modules/Tweaks.php:46
msgid "Disable comments"
msgstr "Wyłącz komentarze"

#: src/Modules/Tweaks.php:47
msgid "Closes comments and pingbacks everywhere and hides existing ones. WooCommerce product reviews keep working when reviews are enabled in WooCommerce."
msgstr "Zamyka komentarze i pingbacki wszędzie i ukrywa istniejące. Opinie o produktach WooCommerce działają dalej, jeśli są włączone w WooCommerce."

#: src/Modules/Tweaks.php:51
msgid "Disable front-end search"
msgstr "Wyłącz wyszukiwarkę w witrynie"

#: src/Modules/Tweaks.php:52
msgid "Search URLs redirect to the home page (stops search-spam pages). Also disables WooCommerce product search."
msgstr "Adresy wyszukiwania przekierowują na stronę główną (koniec ze spamowymi stronami wyników). Wyłącza też wyszukiwanie produktów WooCommerce."

#: src/Modules/Tweaks.php:56
msgid "Disable emoji scripts"
msgstr "Wyłącz skrypty emoji"

#: src/Modules/Tweaks.php:60
msgid "Disable embedding of this site"
msgstr "Wyłącz osadzanie tej witryny"

#: src/Modules/Tweaks.php:61
msgid "Removes oEmbed discovery and wp-embed.js. Embedding YouTube and others in your posts still works."
msgstr "Usuwa wykrywanie oEmbed i wp-embed.js. Osadzanie YouTube i innych serwisów w Twoich wpisach nadal działa."

#: src/Modules/Tweaks.php:65
msgid "Clean up <head>"
msgstr "Uporządkuj <head>"

#: src/Modules/Tweaks.php:66
msgid "Removes RSD, Windows Live Writer, shortlink and adjacent-post links."
msgstr "Usuwa linki RSD, Windows Live Writer, krótki odnośnik i linki do sąsiednich wpisów."

#: src/Modules/Tweaks.php:70
msgid "Slow down Heartbeat"
msgstr "Spowolnij Heartbeat"

#: src/Modules/Tweaks.php:71
msgid "Every 60 seconds instead of 15–60, and not loaded on the front end for visitors."
msgstr "Co 60 sekund zamiast co 15–60 i bez ładowania w witrynie dla odwiedzających."

#: src/Modules/Tweaks.php:75
msgid "Disable self-pingbacks"
msgstr "Wyłącz pingbacki do własnej witryny"

#: src/Modules/Tweaks.php:79
msgid "Revisions to keep"
msgstr "Liczba zachowywanych wersji"

#: src/Modules/Tweaks.php:80
msgid "Empty keeps the WordPress default (unlimited)."
msgstr "Puste pole zostawia domyślne ustawienie WordPressa (bez limitu)."

#: src/Modules/Watch.php:43
msgid "Change alerts"
msgstr "Alerty o zmianach"

#: src/Modules/Watch.php:239
msgid "Accept current state"
msgstr "Zatwierdź obecny stan"

#: src/Modules/Watch.php:246

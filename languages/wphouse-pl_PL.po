msgstr "Wszystkie znaleziska"

#: src/Modules/Vulnerabilities.php:273
msgid "WPHouse vulnerability alerts"
msgstr "Ostrzeżenia WPHouse o lukach"

#: src/Modules/Vulnerabilities.php:286

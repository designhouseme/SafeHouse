#. Plugin Name of the plugin
#: wphouse.php
msgid "WPHouse"
msgstr "WPHouse"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: wphouse.php
msgid "https://designhouse.me/"
msgstr "https://designhouse.me/"

#. Description of the plugin
#: wphouse.php
msgid "Lean, audited replacements for small utility plugins: hardening, install lockdown, change alerts, plugin health and everyday tweaks. Runs alongside Wordfence and WooCommerce."
msgstr "Lekkie, sprawdzone zamienniki małych wtyczek narzędziowych: podstawowe zabezpieczenia, blokada instalacji, alerty o zmianach, kondycja wtyczek i codzienne usprawnienia. Działa obok Wordfence i WooCommerce."

#. Author of the plugin
#: wphouse.php
msgid "Design House"
msgstr "Design House"

#: src/Admin/Page.php:47
msgid "Settings"
msgstr "Ustawienia"

#: src/Admin/Page.php:58
msgid "WPHouse safe mode is on: every module is stopped. Remove wp-content/wphouse-safe-mode or the WPHOUSE_SAFE_MODE constant to resume."
msgstr "Tryb awaryjny WPHouse jest włączony: wszystkie moduły są zatrzymane. Usuń plik wp-content/wphouse-safe-mode lub stałą WPHOUSE_SAFE_MODE, aby je wznowić."

#: src/Admin/Page.php:71
msgid "You are not allowed to do this."
msgstr "Nie masz uprawnień do tej operacji."

#: src/Admin/Page.php:79
msgid "Unknown task."
msgstr "Nieznane zadanie."

#: src/Admin/Page.php:95
msgid "Small, audited replacements for single-purpose plugins. Every module is a switch. Features that Wordfence or wp-config already handle are skipped automatically."
msgstr "Małe, sprawdzone zamienniki jednozadaniowych wtyczek. Każdy moduł włączasz osobno. Funkcje, które obsługuje już Wordfence lub wp-config.php, są automatycznie pomijane."

#: src/Admin/Page.php:98
msgid "Settings are locked by WPHOUSE_LOCK_SETTINGS in wp-config.php. Change them in code."
msgstr "Ustawienia są zablokowane stałą WPHOUSE_LOCK_SETTINGS w wp-config.php. Zmieniaj je w kodzie."

#: src/Admin/Page.php:101
msgid "WPHOUSE_IGNORE_OVERLAPS is on: features run even where another plugin already provides them."
msgstr "Stała WPHOUSE_IGNORE_OVERLAPS jest włączona: funkcje działają nawet tam, gdzie zapewnia je już inna wtyczka."

#: src/Admin/Page.php:108
msgid "General"
msgstr "Ogólne"

#: src/Admin/Page.php:111
msgid "Alert recipients"
msgstr "Odbiorcy alertów"

#: src/Admin/Page.php:114
msgid "Comma-separated. Empty means the site admin address."
msgstr "Adresy oddzielone przecinkami. Puste pole oznacza adres administratora witryny."

#: src/Admin/Page.php:148
msgid "Unavailable"
msgstr "Niedostępny"

#: src/Admin/Page.php:150

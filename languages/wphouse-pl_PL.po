#: src/Admin/Page.php:82
msgid "Settings"
msgstr "Ustawienia"

#: src/Admin/Page.php:107
msgid "WPHouse safe mode is on: every module is stopped. Remove wp-content/wphouse-safe-mode or the WPHOUSE_SAFE_MODE constant to resume."
msgstr "Tryb awaryjny WPHouse jest włączony: wszystkie moduły są zatrzymane. Usuń plik wp-content/wphouse-safe-mode lub stałą WPHOUSE_SAFE_MODE, aby je wznowić."

#: src/Admin/Page.php:120
msgid "You are not allowed to do this."
msgstr "Nie masz uprawnień do tej operacji."

#: src/Admin/Page.php:128
msgid "Unknown task."
msgstr "Nieznane zadanie."

#: src/Admin/Page.php:187
msgid "Small, audited replacements for single-purpose plugins. Every module is a switch. Features that Wordfence or wp-config already handle are skipped automatically."
msgstr "Małe, sprawdzone zamienniki jednozadaniowych wtyczek. Każdy moduł włączasz osobno. Funkcje, które obsługuje już Wordfence lub wp-config.php, są automatycznie pomijane."

#: src/Admin/Page.php:175
msgid "Settings are locked by WPHOUSE_LOCK_SETTINGS in wp-config.php. Change them in code."
msgstr "Ustawienia są zablokowane stałą WPHOUSE_LOCK_SETTINGS w wp-config.php. Zmieniaj je w kodzie."

#: src/Admin/Page.php:178
msgid "WPHOUSE_IGNORE_OVERLAPS is on: features run even where another plugin already provides them."
msgstr "Stała WPHOUSE_IGNORE_OVERLAPS jest włączona: funkcje działają nawet tam, gdzie zapewnia je już inna wtyczka."

#: src/Admin/Page.php:151
#: src/Admin/Page.php:203
msgid "General"
msgstr "Ogólne"

#: src/Admin/Page.php:206
msgid "Alert recipients"
msgstr "Odbiorcy alertów"

#: src/Admin/Page.php:209
msgid "Comma-separated. Empty means the site admin address."
msgstr "Adresy oddzielone przecinkami. Puste pole oznacza adres administratora witryny."

#: src/Admin/Page.php:243
msgid "Unavailable"
msgstr "Niedostępny"

#: src/Admin/Page.php:245
msgid "Running"
msgstr "Działa"

#: src/Admin/Page.php:247
msgid "Enabled, not running"
msgstr "Włączony, nie działa"

#: src/Admin/Page.php:249
msgid "Off"
msgstr "Wyłączony"

#: src/Admin/Page.php:266
msgid "Pinned by WPHOUSE_MODULES in wp-config.php."
msgstr "Ustawione na stałe przez WPHOUSE_MODULES w wp-config.php."

#. translators: %s: plugin or setting name, e.g. Wordfence.
#: src/Admin/Page.php:361
#, php-format
msgid "Handled by %s, skipped here."
msgstr "Obsługuje to %s, więc tutaj pominięte."

#: src/Admin/Page.php:439
msgid "Activity log"
msgstr "Dziennik zdarzeń"

#: src/Admin/Page.php:445
msgid "No events yet."
msgstr "Brak zdarzeń."

#: src/Admin/Page.php:261
#: src/Modules/Vulnerabilities.php:422
msgid "Details"
msgstr "Szczegóły"

#: src/Core/Updater.php:156
msgid "This WPHouse package is not listed in the signed release manifest. Update cancelled."
msgstr "Tej paczki WPHouse nie ma w podpisanym manifeście wydania. Aktualizacja anulowana."

#: src/Core/Updater.php:169
msgid "The downloaded WPHouse package does not match the signed checksum. Update cancelled."
msgstr "Pobrana paczka WPHouse nie zgadza się z podpisaną sumą kontrolną. Aktualizacja anulowana."

#: src/Modules/Duplicate.php:34
msgid "Duplicate posts and pages"
msgstr "Duplikowanie wpisów i stron"

#: src/Modules/Duplicate.php:38
msgid "Adds a \"Duplicate\" link to posts, pages and custom post types. The copy is a draft with the same content, taxonomies and custom fields. WooCommerce products use WooCommerce's own duplicate action."
msgstr "Dodaje link „Duplikuj” do wpisów, stron i własnych typów treści. Kopia to szkic z tą samą treścią, taksonomiami i polami własnymi. Produkty WooCommerce korzystają z własnej akcji duplikowania WooCommerce."

#: src/Modules/Duplicate.php:61
msgid "Duplicate"
msgstr "Duplikuj"

#: src/Modules/Duplicate.php:70
msgid "You are not allowed to duplicate this item."
msgstr "Nie masz uprawnień do zduplikowania tego elementu."

#. translators: %s: original title.
#: src/Modules/Duplicate.php:80
#, php-format
msgid "%s (copy)"
msgstr "%s (kopia)"

#: src/Modules/Hardening.php:70
msgid "Hardening"
msgstr "Podstawowe zabezpieczenia"

#: src/Modules/Hardening.php:74
msgid "Safe defaults: no code editor in wp-admin, no username discovery, generic login errors, no version disclosure, XML-RPC off and basic security headers."
msgstr "Bezpieczne ustawienia domyślne: brak edytora kodu w kokpicie, brak wykrywania nazw użytkowników, ogólne komunikaty błędów logowania, ukryta wersja WordPressa, wyłączone XML-RPC i podstawowe nagłówki bezpieczeństwa."

#: src/Modules/Hardening.php:81
msgid "Disable the theme/plugin file editor"
msgstr "Wyłącz edytor plików motywów i wtyczek"

#: src/Modules/Hardening.php:85
msgid "Block username discovery"
msgstr "Blokuj wykrywanie nazw użytkowników"

#: src/Modules/Hardening.php:86
msgid "For visitors who are not logged in: ?author=N scans, the REST users endpoint, the users sitemap and author data in oEmbed."
msgstr "Dla niezalogowanych odwiedzających: skanowanie ?author=N, endpoint użytkowników w REST API, mapa witryny użytkowników i dane autora w oEmbed."

#: src/Modules/Hardening.php:90
msgid "Generic login errors"
msgstr "Ogólne komunikaty błędów logowania"

#: src/Modules/Hardening.php:91
msgid "One message for a wrong username or a wrong password, on wp-login.php and the WooCommerce login form."
msgstr "Jeden komunikat przy błędnej nazwie użytkownika i przy błędnym haśle, na wp-login.php i w formularzu logowania WooCommerce."

#: src/Modules/Hardening.php:95
msgid "Hide the WordPress version"
msgstr "Ukryj wersję WordPressa"

#: src/Modules/Hardening.php:99
msgid "Disable XML-RPC"
msgstr "Wyłącz XML-RPC"

#: src/Modules/Hardening.php:100
msgid "xmlrpc.php answers 403. The WordPress mobile app and old desktop editors stop working with this site. Skipped automatically when Jetpack or WooPayments is active."
msgstr "xmlrpc.php odpowiada kodem 403. Aplikacja mobilna WordPress i starsze edytory desktopowe przestaną działać z tą witryną. Pomijane automatycznie, gdy aktywny jest Jetpack lub WooPayments."

#: src/Modules/Hardening.php:104
msgid "Basic security headers"
msgstr "Podstawowe nagłówki bezpieczeństwa"

#: src/Modules/Hardening.php:105
msgid "X-Content-Type-Options, Referrer-Policy and X-Frame-Options (same origin). Pages served from a full-page cache may not get them."
msgstr "X-Content-Type-Options, Referrer-Policy i X-Frame-Options (ta sama domena). Strony serwowane z pełnej pamięci podręcznej mogą ich nie dostać."

#: src/Modules/Hardening.php:109
msgid "HSTS (1 year, this domain only)"
msgstr "HSTS (1 rok, tylko ta domena)"

#: src/Modules/Hardening.php:110
msgid "Only on HTTPS. Browsers will refuse plain HTTP for a year, so turn it on only when HTTPS works everywhere on this domain."
msgstr "Tylko przez HTTPS. Przeglądarki przez rok będą odrzucać zwykłe HTTP, więc włącz to dopiero, gdy HTTPS działa w całej domenie."

#: src/Modules/Hardening.php:176
msgid "Sorry, you are not allowed to list users."
msgstr "Nie masz uprawnień do wyświetlania listy użytkowników."

#: src/Modules/Hardening.php:208
msgid "<strong>Error:</strong> The username, email address or password is incorrect."
msgstr "<strong>Błąd:</strong> nazwa użytkownika, adres e-mail lub hasło są nieprawidłowe."

#: src/Modules/Lockdown.php:40
msgid "Install lockdown"
msgstr "Blokada instalacji"

#: src/Modules/Lockdown.php:44
msgid "Nobody can install new plugins or themes or upload ZIP files, not even through a vulnerable plugin that skips permission checks. Updates keep working. Unlock for 30 minutes when you need to install something."
msgstr "Nikt nie zainstaluje nowych wtyczek ani motywów ani nie wgra plików ZIP, nawet przez podatną wtyczkę, która pomija sprawdzanie uprawnień. Aktualizacje działają normalnie. Gdy trzeba coś zainstalować, odblokuj instalację na 30 minut."

#: src/Modules/Lockdown.php:56
msgid "DISALLOW_FILE_MODS in wp-config.php already blocks all installs and updates."
msgstr "Stała DISALLOW_FILE_MODS w wp-config.php już blokuje wszystkie instalacje i aktualizacje."

#: src/Modules/Lockdown.php:100
msgid "Installing plugins and themes is locked by WPHouse. Unlock it first (WPHouse in the admin menu or `wp wphouse unlock`)."
msgstr "Instalowanie wtyczek i motywów jest zablokowane przez WPHouse. Najpierw je odblokuj (WPHouse w menu kokpitu lub `wp wphouse unlock`)."

#: src/Modules/Lockdown.php:122
msgid "Lock now"
msgstr "Zablokuj teraz"

#: src/Modules/Lockdown.php:127
msgid "Unlock installs for 30 minutes"
msgstr "Odblokuj instalację na 30 minut"

#: src/Modules/Lockdown.php:133
msgid "Installs are unlocked for 30 minutes."
msgstr "Instalacja jest odblokowana na 30 minut."

#: src/Modules/Lockdown.php:136
msgid "Installs are locked."
msgstr "Instalacja jest zablokowana."

#. translators: %s: time, e.g. 14:35
#: src/Modules/Lockdown.php:144
#, php-format
msgid "Unlocked until %s."
msgstr "Odblokowane do %s."

#: src/Modules/Lockdown.php:146
msgid "Locked. Updates of installed plugins, themes and core still work."
msgstr "Zablokowane. Aktualizacje zainstalowanych wtyczek, motywów i WordPressa nadal działają."

#: src/Modules/Maintenance.php:40
msgid "Maintenance mode"
msgstr "Tryb serwisowy"

#: src/Modules/Maintenance.php:44
msgid "Visitors see a short \"back soon\" page with HTTP 503, which search engines understand as temporary. Logged-in staff see the normal site. Payment callbacks, the REST API and cron keep working."
msgstr "Odwiedzający widzą krótką stronę „Zaraz wracamy” z kodem HTTP 503, który wyszukiwarki rozumieją jako przerwę tymczasową. Zalogowani pracownicy widzą normalną witrynę. Powiadomienia z bramek płatności, REST API i cron działają dalej."

#: src/Modules/Maintenance.php:51
msgid "Headline"
msgstr "Nagłówek"

#: src/Modules/Maintenance.php:52
msgid "Empty: \"We will be back soon\"."
msgstr "Puste pole: „Zaraz wracamy”."

#: src/Modules/Maintenance.php:57
msgid "Message"
msgstr "Wiadomość"

#: src/Modules/Maintenance.php:58
msgid "Basic HTML allowed (links, bold, line breaks)."
msgstr "Dozwolony prosty HTML (linki, pogrubienie, nowe linie)."

#: src/Modules/Maintenance.php:63
msgid "Expected duration (minutes)"
msgstr "Przewidywany czas (minuty)"

#: src/Modules/Maintenance.php:64
msgid "Sent to search engines as Retry-After."
msgstr "Przekazywany wyszukiwarkom w nagłówku Retry-After."

#: src/Modules/Maintenance.php:70
msgid "Who sees the normal site"
msgstr "Kto widzi normalną witrynę"

#: src/Modules/Maintenance.php:72
msgid "Administrators"
msgstr "Administratorzy"

#: src/Modules/Maintenance.php:73
msgid "Anyone who can edit content"
msgstr "Każdy, kto może edytować treści"

#: src/Modules/Maintenance.php:74
msgid "Every logged-in user"
msgstr "Każdy zalogowany użytkownik"

#: src/Modules/Maintenance.php:111
msgid "We will be back soon"
msgstr "Zaraz wracamy"

#: src/Modules/Maintenance.php:149
msgid "Maintenance mode is on"
msgstr "Tryb serwisowy jest włączony"

#: src/Modules/PluginHealth.php:100
msgid "Plugin health"
msgstr "Kondycja wtyczek"

#: src/Modules/PluginHealth.php:104
msgid "Weekly check of installed plugins: closed on WordPress.org (often for security reasons), no update for two years, not from WordPress.org, one-time tools left active, inactive leftovers, and plugins a WPHouse module replaces. Results also appear in Tools → Site Health."
msgstr "Cotygodniowy przegląd zainstalowanych wtyczek: zamknięte na WordPress.org (często z powodów bezpieczeństwa), bez aktualizacji od dwóch lat, spoza WordPress.org, jednorazowe narzędzia pozostawione jako aktywne, nieaktywne pozostałości oraz wtyczki, które zastępuje moduł WPHouse. Wyniki widać też w Narzędzia → Stan witryny."

#: src/Modules/PluginHealth.php:228
msgid "Inactive. Inactive plugins can still be attacked through their files; delete it if you do not need it."
msgstr "Nieaktywna. Nieaktywne wtyczki nadal można zaatakować przez ich pliki; usuń ją, jeśli nie jest potrzebna."

#. translators: 1: date, 2: reason code from WordPress.org, e.g. security-issue.
#: src/Modules/PluginHealth.php:255
#, php-format
msgid "Closed on WordPress.org (%1$s, reason: %2$s). It gets no more updates; replace or remove it."
msgstr "Zamknięta na WordPress.org (%1$s, powód: %2$s). Nie dostanie już aktualizacji; zastąp ją albo usuń."

#. translators: %s: date of the last update.
#: src/Modules/PluginHealth.php:261
#, php-format
msgid "No update since %s. Probably abandoned."
msgstr "Brak aktualizacji od %s. Prawdopodobnie porzucona."

#: src/Modules/PluginHealth.php:266
msgid "Not on WordPress.org and no update source declared. Make sure you know where its updates come from."
msgstr "Nie ma jej na WordPress.org i nie deklaruje źródła aktualizacji. Upewnij się, skąd przychodzą jej aktualizacje."

#: src/Modules/PluginHealth.php:271
msgid "Updates come from its vendor, not WordPress.org. Keep the licence active so security fixes arrive."
msgstr "Aktualizacje przychodzą od producenta, nie z WordPress.org. Utrzymuj aktywną licencję, żeby docierały poprawki bezpieczeństwa."

#: src/Modules/PluginHealth.php:276
msgid "One-time tool (migration, search-replace, import, file access or debugging) left active. Delete it when the job is done."
msgstr "Jednorazowe narzędzie (migracja, wyszukaj-i-zamień, import, dostęp do plików lub debugowanie) pozostawione jako aktywne. Usuń je po zakończeniu pracy."

#. translators: %s: WPHouse module name.
#: src/Modules/PluginHealth.php:283
#, php-format
msgid "WPHouse can do this: module \"%s\". Switch it on, then remove this plugin."
msgstr "WPHouse to potrafi: moduł „%s”. Włącz go, a potem usuń tę wtyczkę."

#: src/Modules/PluginHealth.php:307
msgid "WPHouse plugin health"
msgstr "Kondycja wtyczek (WPHouse)"

#: src/Modules/PluginHealth.php:328
msgid "No closed, abandoned or forgotten plugins found"
msgstr "Nie znaleziono zamkniętych, porzuconych ani zapomnianych wtyczek"

#: src/Modules/PluginHealth.php:329
msgid "Some plugins need attention"
msgstr "Niektóre wtyczki wymagają uwagi"

#: src/Modules/PluginHealth.php:334
#: src/Modules/Vulnerabilities.php:301
msgid "Security"
msgstr "Bezpieczeństwo"

#. translators: 1: number of critical findings, 2: number of warnings.
#: src/Modules/PluginHealth.php:340
#, php-format
msgid "%1$d critical, %2$d warnings. Details are on the WPHouse settings page."
msgstr "Krytyczne: %1$d, ostrzeżenia: %2$d. Szczegóły na stronie ustawień WPHouse."

#: src/Modules/PluginHealth.php:345
msgid "Open WPHouse"
msgstr "Otwórz WPHouse"

#: src/Modules/PluginHealth.php:351
#: src/Modules/Vulnerabilities.php:311
#: src/Modules/Watch.php:193
msgid "Check now"
msgstr "Sprawdź teraz"

#. translators: %s: error message.
#: src/Modules/PluginHealth.php:358
#, php-format
msgid "Could not reach WordPress.org: %s"
msgstr "Nie udało się połączyć z WordPress.org: %s"

#: src/Modules/PluginHealth.php:359
msgid "Plugin health updated."
msgstr "Kondycja wtyczek zaktualizowana."

#: src/Modules/PluginHealth.php:366
msgid "Not checked yet. Use \"Check now\" or wait for the daily run."
msgstr "Jeszcze nie sprawdzono. Kliknij „Sprawdź teraz” albo poczekaj na codzienne sprawdzenie."

#. translators: %s: date and time.
#: src/Modules/PluginHealth.php:370
#: src/Modules/Vulnerabilities.php:330
#, php-format
msgid "Last check: %s."
msgstr "Ostatnie sprawdzenie: %s."

#. translators: %s: error message.
#: src/Modules/PluginHealth.php:372
#, php-format
msgid "The last refresh failed: %s"
msgstr "Ostatnie odświeżenie nie powiodło się: %s"

#: src/Modules/PluginHealth.php:377
msgid "Nothing to report."
msgstr "Brak uwag."

#: src/Modules/PluginHealth.php:380
msgid "Plugin"
msgstr "Wtyczka"

#: src/Modules/PluginHealth.php:380
msgid "Findings"
msgstr "Wyniki"

#: src/Admin/Page.php:411
#: src/Modules/PluginHealth.php:382
msgid "inactive"
msgstr "nieaktywna"

#: src/Modules/Scripts.php:39
msgid "Header and footer scripts"
msgstr "Skrypty w nagłówku i stopce"

#: src/Modules/Scripts.php:43
msgid "Adds tracking codes, verification tags and widgets to every front-end page. HTML and JavaScript only, never PHP. Only administrators who may post unfiltered HTML can edit them."
msgstr "Dodaje kody śledzące, tagi weryfikacyjne i widżety do każdej strony witryny. Tylko HTML i JavaScript, nigdy PHP. Edytować je mogą wyłącznie administratorzy z uprawnieniem do niefiltrowanego HTML."

#: src/Modules/Scripts.php:50
msgid "In <head>"
msgstr "W <head>"

#: src/Modules/Scripts.php:51
msgid "Printed early in <head>. Google Tag Manager, analytics, verification meta tags."
msgstr "Wstawiane na początku <head>. Google Tag Manager, analityka, tagi meta weryfikacji."

#: src/Modules/Scripts.php:56
msgid "After <body>"
msgstr "Po <body>"

#: src/Modules/Scripts.php:57
msgid "Needs a theme that calls wp_body_open() (all current themes do). GTM noscript iframe."
msgstr "Wymaga motywu wywołującego wp_body_open() (robią to wszystkie aktualne motywy). Ramka noscript GTM."

#: src/Modules/Scripts.php:62
msgid "Before </body>"
msgstr "Przed </body>"

#: src/Modules/Scripts.php:63
msgid "Chat widgets, pixels and other scripts that can load last."
msgstr "Widżety czatu, piksele i inne skrypty, które mogą ładować się na końcu."

#: src/Modules/Scripts.php:68
msgid "Do not output for logged-in administrators"
msgstr "Nie wstawiaj dla zalogowanych administratorów"

#: src/Modules/Scripts.php:69
msgid "Keeps your own visits out of analytics."
msgstr "Twoje własne wizyty nie trafią do statystyk."

#: src/Modules/Scripts.php:79
msgid "DISALLOW_UNFILTERED_HTML is set in wp-config.php, so nobody may add raw scripts."
msgstr "W wp-config.php ustawiono DISALLOW_UNFILTERED_HTML, więc nikt nie może dodawać surowych skryptów."

#: src/Modules/Smtp.php:40
msgid "SMTP mail"
msgstr "Poczta SMTP"

#: src/Modules/Smtp.php:44
msgid "Sends all WordPress and WooCommerce mail through your SMTP server, with credentials kept in wp-config.php. No mail log, so password-reset links are never stored."
msgstr "Wysyła całą pocztę WordPressa i WooCommerce przez Twój serwer SMTP, z danymi logowania w wp-config.php. Bez dziennika wiadomości, więc linki do resetu hasła nigdzie nie są zapisywane."

#: src/Modules/Smtp.php:51
msgid "From address"
msgstr "Adres nadawcy"

#: src/Modules/Smtp.php:52
msgid "Used when the sender is not set otherwise (WooCommerce sets its own). Should be on a domain your SMTP server may send for."
msgstr "Używany, gdy nadawca nie jest ustawiony inaczej (WooCommerce ustawia własnego). Powinien należeć do domeny, z której Twój serwer SMTP może wysyłać."

#: src/Modules/Smtp.php:57
msgid "From name"
msgstr "Nazwa nadawcy"

#: src/Modules/Smtp.php:129
msgid "Send a test e-mail to me"
msgstr "Wyślij do mnie testowy e-mail"

#: src/Modules/Smtp.php:141
msgid "WPHouse test e-mail"
msgstr "Testowy e-mail WPHouse"

#: src/Modules/Smtp.php:142
msgid "If you can read this, WordPress can send mail."
msgstr "Jeśli to czytasz, WordPress potrafi wysyłać pocztę."

#. translators: %s: e-mail address.
#: src/Modules/Smtp.php:148
#, php-format
msgid "Test e-mail sent to %s."
msgstr "Testowy e-mail wysłany na adres %s."

#. translators: %s: error message.
#: src/Modules/Smtp.php:151
#, php-format
msgid "Sending failed: %s"
msgstr "Wysyłka nie powiodła się: %s"

#. translators: %s: error message.
#: src/Modules/Smtp.php:151
msgid "unknown error"
msgstr "nieznany błąd"

#: src/Modules/Smtp.php:157
msgid "with login"
msgstr "z logowaniem"

#: src/Modules/Smtp.php:157
msgid "without login"
msgstr "bez logowania"

#. translators: 1: SMTP host, 2: port, 3: "with login" or "without login".
#: src/Modules/Smtp.php:160
#, php-format
msgid "SMTP: %1$s:%2$d, %3$s (from wp-config.php)."
msgstr "SMTP: %1$s:%2$d, %3$s (z wp-config.php)."

#: src/Modules/Smtp.php:162
msgid "SMTP is not configured: add WPHOUSE_SMTP_HOST (and port, user, password) to wp-config.php. Until then mail goes through PHP mail(); the From settings still apply."
msgstr "SMTP nie jest skonfigurowany: dodaj WPHOUSE_SMTP_HOST (oraz port, użytkownika i hasło) do wp-config.php. Do tego czasu poczta idzie przez PHP mail(); ustawienia nadawcy nadal działają."

#: src/Modules/Tweaks.php:35
msgid "Tweaks"
msgstr "Usprawnienia"

#: src/Modules/Tweaks.php:39
msgid "Small switches that are usually a plugin each: comments, search, emojis, embeds, head clean-up, Heartbeat, self-pingbacks and revision limits."
msgstr "Drobne przełączniki, z których każdy to zwykle osobna wtyczka: komentarze, wyszukiwarka, emoji, osadzanie, porządki w <head>, Heartbeat, pingbacki do siebie i limit wersji."

#: src/Modules/Tweaks.php:46
msgid "Disable comments"
msgstr "Wyłącz komentarze"

#: src/Modules/Tweaks.php:47
msgid "Closes comments and pingbacks everywhere and hides existing ones. WooCommerce product reviews keep working when reviews are enabled in WooCommerce."
msgstr "Zamyka komentarze i pingbacki wszędzie i ukrywa istniejące. Opinie o produktach WooCommerce działają dalej, jeśli są włączone w WooCommerce."

#: src/Modules/Tweaks.php:51
msgid "Disable front-end search"
msgstr "Wyłącz wyszukiwarkę w witrynie"

#: src/Modules/Tweaks.php:52
msgid "Search URLs redirect to the home page (stops search-spam pages). Also disables WooCommerce product search."
msgstr "Adresy wyszukiwania przekierowują na stronę główną (koniec ze spamowymi stronami wyników). Wyłącza też wyszukiwanie produktów WooCommerce."

#: src/Modules/Tweaks.php:56
msgid "Disable emoji scripts"
msgstr "Wyłącz skrypty emoji"

#: src/Modules/Tweaks.php:60
msgid "Disable embedding of this site"
msgstr "Wyłącz osadzanie tej witryny"

#: src/Modules/Tweaks.php:61
msgid "Removes oEmbed discovery and wp-embed.js. Embedding YouTube and others in your posts still works."
msgstr "Usuwa wykrywanie oEmbed i wp-embed.js. Osadzanie YouTube i innych serwisów w Twoich wpisach nadal działa."

#: src/Modules/Tweaks.php:65
msgid "Clean up <head>"
msgstr "Uporządkuj <head>"

#: src/Modules/Tweaks.php:66
msgid "Removes RSD, Windows Live Writer, shortlink and adjacent-post links."
msgstr "Usuwa linki RSD, Windows Live Writer, krótki odnośnik i linki do sąsiednich wpisów."

#: src/Modules/Tweaks.php:70
msgid "Slow down Heartbeat"
msgstr "Spowolnij Heartbeat"

#: src/Modules/Tweaks.php:71
msgid "Every 60 seconds instead of 15–60, and not loaded on the front end for visitors."
msgstr "Co 60 sekund zamiast co 15–60 i bez ładowania w witrynie dla odwiedzających."

#: src/Modules/Tweaks.php:75
msgid "Disable self-pingbacks"
msgstr "Wyłącz pingbacki do własnej witryny"

#: src/Modules/Tweaks.php:79
msgid "Revisions to keep"
msgstr "Liczba zachowywanych wersji"

#: src/Modules/Tweaks.php:80
msgid "Empty keeps the WordPress default (unlimited)."
msgstr "Puste pole zostawia domyślne ustawienie WordPressa (bez limitu)."

#: src/Modules/Watch.php:40
msgid "Change alerts"
msgstr "Alerty o zmianach"

#: src/Modules/Watch.php:44
msgid "E-mails the alert recipients when an administrator is added, a plugin or theme appears or is activated, a mu-plugin or drop-in shows up, or wp-config.php changes. Changes are also written to the activity log."
msgstr "Wysyła e-mail do odbiorców alertów, gdy przybędzie administrator, pojawi się lub zostanie włączona wtyczka albo motyw, pojawi się wtyczka obowiązkowa (mu-plugin) lub drop-in albo zmieni się wp-config.php. Zmiany trafiają też do dziennika zdarzeń."

#: src/Modules/Watch.php:194
msgid "Accept current state"
msgstr "Zatwierdź obecny stan"

#: src/Modules/Watch.php:201
msgid "The current state is the new baseline."
msgstr "Obecny stan jest nowym punktem odniesienia."

#. translators: %d: number of changes.
#: src/Modules/Watch.php:205
#, php-format
msgid "%d change found and reported."
msgid_plural "%d changes found and reported."
msgstr[0] "Znaleziono i zgłoszono %d zmianę."
msgstr[1] "Znaleziono i zgłoszono %d zmiany."
msgstr[2] "Znaleziono i zgłoszono %d zmian."

#. translators: %d: number of changes.
#: src/Modules/Watch.php:205
msgid "No changes since the last check."
msgstr "Brak zmian od ostatniego sprawdzenia."

#: src/Modules/Watch.php:212
msgid "No baseline yet. It is recorded on the first hourly check."
msgstr "Brak punktu odniesienia. Zostanie zapisany przy pierwszym cogodzinnym sprawdzeniu."

#. translators: 1: number of administrators, 2: number of plugins, 3: number of mu-plugins, 4: number of drop-ins.
#: src/Modules/Watch.php:217
#, php-format
msgid "Watching %1$d administrators, %2$d plugins, %3$d must-use plugins, %4$d drop-ins and wp-config.php."
msgstr "Obserwowane: administratorzy (%1$d), wtyczki (%2$d), wtyczki obowiązkowe (%3$d), drop-iny (%4$d) i wp-config.php."

#: src/Plugin.php:122
msgid "WPHouse 0.x supports single sites only. Activate it per site instead of network-wide."
msgstr "WPHouse 0.x obsługuje tylko pojedyncze witryny. Włącz wtyczkę na poszczególnych witrynach, a nie w całej sieci."

#: wphouse.php:32
msgid "WPHouse requires PHP 8.1 or newer. The plugin is inactive."
msgstr "WPHouse wymaga PHP 8.1 lub nowszego. Wtyczka jest nieaktywna."

#: src/Modules/Vulnerabilities.php:63
msgid "Vulnerability alerts"
msgstr "Ostrzeżenia o lukach"

#: src/Modules/Vulnerabilities.php:67
msgid "Warns when the installed WordPress, a plugin or a theme has a known security vulnerability, and names the version that fixes it. Meant for sites without Wordfence, which does this itself. Data from Wordfence Intelligence, signed and served by the WPHouse update host, checked every 6 hours."
msgstr "Ostrzega, gdy zainstalowany WordPress, wtyczka lub motyw ma znaną lukę bezpieczeństwa, i podaje wersję, która ją łata. Dla stron bez Wordfence, który robi to sam. Dane z Wordfence Intelligence, podpisane i udostępniane przez serwer aktualizacji WPHouse, sprawdzane co 6 godzin."

#: src/Modules/Vulnerabilities.php:79
msgid "Wordfence is active and already warns about vulnerable plugins, themes and WordPress versions."
msgstr "Wordfence jest aktywny i sam ostrzega o podatnych wtyczkach, motywach i wersjach WordPressa."

#. translators: %d: number of vulnerabilities.
#: src/Modules/Vulnerabilities.php:248
#, php-format
msgid "%d known vulnerability in installed software"
msgid_plural "%d known vulnerabilities in installed software"
msgstr[0] "%d znana luka w zainstalowanym oprogramowaniu"
msgstr[1] "%d znane luki w zainstalowanym oprogramowaniu"
msgstr[2] "%d znanych luk w zainstalowanym oprogramowaniu"

#: src/Modules/Vulnerabilities.php:259
msgid "Security vulnerability in installed software"
msgstr "Luka bezpieczeństwa w zainstalowanym oprogramowaniu"

#: src/Modules/Vulnerabilities.php:263
#: src/Modules/Vulnerabilities.php:305
msgid "Go to updates"
msgstr "Przejdź do aktualizacji"

#: src/Modules/Vulnerabilities.php:264
msgid "All findings"
msgstr "Wszystkie znaleziska"

#: src/Modules/Vulnerabilities.php:273
msgid "WPHouse vulnerability alerts"
msgstr "Ostrzeżenia WPHouse o lukach"

#: src/Modules/Vulnerabilities.php:286
msgid "Installed software has known vulnerabilities"
msgstr "Zainstalowane oprogramowanie ma znane luki"

#: src/Modules/Vulnerabilities.php:290
msgid "Vulnerability data has not been downloaded yet"
msgstr "Dane o lukach nie zostały jeszcze pobrane"

#: src/Modules/Vulnerabilities.php:294
msgid "No known vulnerabilities in installed software"
msgstr "Brak znanych luk w zainstalowanym oprogramowaniu"

#. translators: %s: error message.
#: src/Modules/Vulnerabilities.php:319
#, php-format
msgid "Could not download vulnerability data: %s"
msgstr "Nie udało się pobrać danych o lukach: %s"

#: src/Modules/Vulnerabilities.php:320
msgid "Vulnerability data updated."
msgstr "Dane o lukach zostały zaktualizowane."

#: src/Modules/Vulnerabilities.php:327
msgid "Not checked yet. Use \"Check now\" or wait for the next hourly run."
msgstr "Jeszcze nie sprawdzono. Użyj „Sprawdź teraz” albo poczekaj na najbliższe cogodzinne sprawdzenie."

#. translators: %s: error message.
#: src/Modules/Vulnerabilities.php:333
#, php-format
msgid "The last download failed: %s"
msgstr "Ostatnie pobieranie nie powiodło się: %s"

#: src/Modules/Vulnerabilities.php:339
msgid "No known vulnerabilities in installed software."
msgstr "Brak znanych luk w zainstalowanym oprogramowaniu."

#: src/Modules/Vulnerabilities.php:342
msgid "Software"
msgstr "Oprogramowanie"

#: src/Modules/Vulnerabilities.php:342
msgid "Vulnerability"
msgstr "Luka"

#: src/Modules/Vulnerabilities.php:342
msgid "Fixed in"
msgstr "Poprawka w wersji"

#: src/Modules/Vulnerabilities.php:347
msgid "no fix yet"
msgstr "brak poprawki"

#. translators: 1: software name, 2: installed version, 3: CVSS score in brackets or empty, 4: vulnerability title, 5: fixed version(s).
#: src/Modules/Vulnerabilities.php:408
#, php-format
msgid "%1$s %2$s%3$s: %4$s. Update to %5$s or later."
msgstr "%1$s %2$s%3$s: %4$s. Zaktualizuj do wersji %5$s lub nowszej."

#. translators: 1: software name, 2: installed version, 3: CVSS score in brackets or empty, 4: vulnerability title.
#: src/Modules/Vulnerabilities.php:410
#, php-format
msgid "%1$s %2$s%3$s: %4$s. No fixed version yet: deactivate it if you can do without it."
msgstr "%1$s %2$s%3$s: %4$s. Nie ma jeszcze poprawionej wersji: wyłącz to oprogramowanie, jeśli możesz się bez niego obejść."

#: src/Admin/Page.php:376
msgid "WPHouse skips what Wordfence already does (for example username discovery and login error masking) and leaves the firewall, two-factor login and malware scans to it. Vulnerability alerts stand down, because Wordfence warns about vulnerable plugins itself."
msgstr "WPHouse pomija to, co Wordfence już robi (na przykład blokadę wyliczania użytkowników i ogólne błędy logowania), a zaporę, logowanie dwuetapowe i skaner złośliwego kodu zostawia jemu. Ostrzeżenia o lukach się wyłączają, bo Wordfence sam ostrzega o podatnych wtyczkach."

#: src/Admin/Page.php:377
msgid "Compatible with HPOS and the block checkout. Generic login errors also cover the My Account form, maintenance mode lets the Store API and payment callbacks through, and product reviews survive \"disable comments\"."
msgstr "Zgodny z HPOS i blokowym checkoutem. Ogólne błędy logowania obejmują też formularz „Moje konto”, tryb serwisowy przepuszcza Store API i powiadomienia z płatności, a recenzje produktów zostają mimo wyłączenia komentarzy."

#: src/Admin/Page.php:378
msgid "Payment gateways"
msgstr "Bramki płatności"

#: src/Admin/Page.php:378
msgid "Autopay, Przelewy24, PayU, imoje, Paynow, Stripe, PayPal and WooPayments. Their callbacks (?wc-api= and the REST API) pass maintenance mode, and XML-RPC stays on for WooPayments."
msgstr "Autopay, Przelewy24, PayU, imoje, Paynow, Stripe, PayPal i WooPayments. Ich powiadomienia (?wc-api= i REST API) przechodzą przez tryb serwisowy, a dla WooPayments XML-RPC zostaje włączone."

#: src/Admin/Page.php:380
msgid "Elementor and Elementor Pro. Watched for new vulnerabilities like everything on this list."
msgstr "Elementor i Elementor Pro. Pilnujemy ich nowych luk, jak wszystkiego na tej liście."

#: src/Admin/Page.php:150
#: src/Admin/Page.php:385
msgid "Integrations"
msgstr "Integracje"

#: src/Admin/Page.php:386
msgid "WPHouse is built to run alongside these plugins. Design House watches all of them for new vulnerabilities (CVE) and tells you when an update cannot wait."
msgstr "WPHouse działa razem z tymi wtyczkami. Design House pilnuje nowych luk (CVE) we wszystkich z nich i daje znać, gdy aktualizacja nie może czekać."

#: src/Admin/Page.php:389
msgid "Integration"
msgstr "Integracja"

#: src/Admin/Page.php:390
msgid "On this site"
msgstr "Na tej stronie"

#: src/Admin/Page.php:391
msgid "What WPHouse does"
msgstr "Co robi WPHouse"

#: src/Admin/Page.php:401
msgid "not installed"
msgstr "nie zainstalowano"

#: src/Admin/Page.php:405
msgid "WPHouse vulnerability alerts cover this site. For a firewall and two-factor login, install Wordfence."
msgstr "Tę stronę chronią ostrzeżenia WPHouse o lukach. Zaporę i logowanie dwuetapowe da Wordfence."

#: src/Admin/Page.php:406
msgid "Nothing warns about vulnerable plugins on this site: switch on WPHouse vulnerability alerts below, or install Wordfence."
msgstr "Nic nie ostrzega na tej stronie o podatnych wtyczkach: włącz niżej ostrzeżenia WPHouse o lukach albo zainstaluj Wordfence."

#: src/Admin/Page.php:411
msgid "active"
msgstr "aktywna"

#. Description of the plugin
#: wphouse.php
msgid "One plugin instead of a dozen small ones: hardening, install lockdown, change and vulnerability alerts, plugin health and everyday tweaks. Works alongside Wordfence, WooCommerce and the usual payment gateways."
msgstr "Jedna wtyczka zamiast kilkunastu małych: zabezpieczenia, blokada instalacji, alerty o zmianach i lukach, kondycja wtyczek i codzienne usprawnienia. Działa obok Wordfence, WooCommerce i popularnych bramek płatności."

#: src/Admin/Page.php:149
msgid "Modules"
msgstr "Moduły"

#. translators: 1: number of modules running, 2: number of modules.
#: src/Admin/Page.php:167
#, php-format
msgid "%1$d of %2$d running"
msgstr "Działa %1$d z %2$d"

#: src/Admin/Page.php:379
msgid "WPHouse has no object cache of its own: on servers with Redis, this is the plugin we recommend. The status shows whether its drop-in is connected."
msgstr "WPHouse nie ma własnej pamięci podręcznej obiektów: na serwerach z Redisem polecamy tę wtyczkę. Status pokazuje, czy jej drop-in jest połączony."

#: src/Admin/Page.php:415
msgid "Another persistent object cache is in use."
msgstr "Działa inna trwała pamięć podręczna obiektów."

#: src/Admin/Page.php:417
msgid "Object cache connected to Redis."
msgstr "Pamięć podręczna obiektów jest połączona z Redisem."

#: src/Admin/Page.php:419
msgid "Object cache drop-in installed, but Redis is not reachable."
msgstr "Drop-in pamięci podręcznej obiektów jest zainstalowany, ale Redis jest nieosiągalny."

#. translators: %s: time since the event, e.g. "5 mins".
#: src/Admin/Page.php:463
#, php-format
msgid "%s ago"
msgstr "%s temu"

#: src/Modules/LiteSpeed.php:56
msgid "LiteSpeed page cache"
msgstr "Cache stron LiteSpeed"

#: src/Modules/LiteSpeed.php:60
msgid "On LiteSpeed servers, pages for visitors who are not logged in and have no cart are served from the server cache without running WordPress. WPHouse only sends cache headers and clears the cache after changes; it writes no files. Logged-in users, the cart, checkout and account pages are never cached."
msgstr "Na serwerach LiteSpeed strony dla niezalogowanych odwiedzających bez koszyka idą z cache serwera, bez uruchamiania WordPressa. WPHouse wysyła tylko nagłówki cache i czyści cache po zmianach; nie zapisuje żadnych plików. Zalogowani, koszyk, zamówienie i konto klienta nigdy nie trafiają do cache."

#: src/Modules/LiteSpeed.php:67
msgid "Keep pages for (minutes)"
msgstr "Trzymaj strony przez (minuty)"

#: src/Modules/LiteSpeed.php:68
msgid "At most 8 hours, so forms on cached pages still carry a valid security token. Changes clear the cache anyway."
msgstr "Najwyżej 8 godzin, żeby formularze na stronach z cache miały ważny token bezpieczeństwa. Zmiany i tak czyszczą cache."

#: src/Modules/LiteSpeed.php:74
msgid "Never cache these paths"
msgstr "Nigdy nie cache'uj tych ścieżek"

#: src/Modules/LiteSpeed.php:75
msgid "One per line, for example /contact/. A line matches every address that starts with it."
msgstr "Jedna w wierszu, na przykład /kontakt/. Wiersz pasuje do każdego adresu, który się od niego zaczyna."

#: src/Modules/LiteSpeed.php:86
msgid "The LiteSpeed Cache plugin is active and manages the server cache itself."
msgstr "Wtyczka LiteSpeed Cache jest aktywna i sama zarządza cache serwera."

#: src/Modules/LiteSpeed.php:210
msgid "Clear the cache"
msgstr "Wyczyść cache"

#: src/Modules/LiteSpeed.php:216
msgid "LiteSpeed was asked to clear the cache."
msgstr "LiteSpeed dostał polecenie wyczyszczenia cache."

#: src/Modules/LiteSpeed.php:224
msgid "This server is LiteSpeed. Tools → Site Health checks whether it actually serves pages from its cache."
msgstr "Ten serwer to LiteSpeed. Narzędzia → Zdrowie witryny sprawdza, czy faktycznie podaje strony z cache."

#: src/Modules/LiteSpeed.php:225
msgid "This server does not look like LiteSpeed, so the cache headers have no effect here."
msgstr "Ten serwer nie wygląda na LiteSpeed, więc nagłówki cache nic tu nie dają."

#: src/Modules/LiteSpeed.php:236
msgid "WPHouse LiteSpeed page cache"
msgstr "Cache stron LiteSpeed w WPHouse"

#: src/Modules/LiteSpeed.php:265
msgid "LiteSpeed serves pages from its cache"
msgstr "LiteSpeed podaje strony z cache"

#: src/Modules/LiteSpeed.php:266
msgid "The home page came from the LiteSpeed cache for a visitor who is not logged in."
msgstr "Strona główna przyszła z cache LiteSpeed dla niezalogowanego odwiedzającego."

#: src/Modules/LiteSpeed.php:269
msgid "LiteSpeed does not serve pages from its cache yet"
msgstr "LiteSpeed jeszcze nie podaje stron z cache"

#: src/Modules/LiteSpeed.php:270
msgid "The server is LiteSpeed, but the home page was not served from its cache. On LiteSpeed Enterprise add this to .htaccess, or ask your host to turn the cache on: <IfModule LiteSpeed> CacheLookup public on </IfModule>. A page that sets a cookie for every visitor is never cached either."
msgstr "Serwer to LiteSpeed, ale strona główna nie przyszła z cache. Na LiteSpeed Enterprise dodaj to do .htaccess albo poproś hosting o włączenie cache: <IfModule LiteSpeed> CacheLookup public on </IfModule>. Strona, która ustawia ciasteczko każdemu odwiedzającemu, też nigdy nie trafi do cache."

#: src/Modules/LiteSpeed.php:273
msgid "The server is not LiteSpeed"
msgstr "Serwer to nie LiteSpeed"

#: src/Modules/LiteSpeed.php:274
msgid "The LiteSpeed page cache module has no effect on this server. Switch it off, or use the cache your host provides."
msgstr "Moduł cache stron LiteSpeed nic nie daje na tym serwerze. Wyłącz go albo użyj cache, które daje hosting."

#: src/Modules/LiteSpeed.php:278
msgid "WooCommerce geolocates customers without page caching support, so cached pages may show one country's prices and taxes to everyone. In WooCommerce → Settings → General choose \"Geolocate (with page caching support)\"."
msgstr "WooCommerce geolokalizuje klientów bez obsługi cache stron, więc strony z cache mogą pokazywać wszystkim ceny i podatki jednego kraju. W WooCommerce → Ustawienia → Ogólne wybierz geolokalizację z obsługą cache stron (Geolocate with page caching support)."

#: src/Modules/LiteSpeed.php:284
msgid "Performance"
msgstr "Wydajność"

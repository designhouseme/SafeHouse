#: src/Admin/Page.php:83
msgid "Settings"
msgstr "Ustawienia"

#: src/Admin/Page.php:108
msgid "WPHouse safe mode is on: every module is stopped. Remove wp-content/wphouse-safe-mode or the WPHOUSE_SAFE_MODE constant to resume."
msgstr "Tryb awaryjny WPHouse jest włączony: wszystkie moduły są zatrzymane. Usuń plik wp-content/wphouse-safe-mode lub stałą WPHOUSE_SAFE_MODE, aby je wznowić."

#: src/Admin/Page.php:121
msgid "You are not allowed to do this."
msgstr "Nie masz uprawnień do tej operacji."

#: src/Admin/Page.php:129
msgid "Unknown task."
msgstr "Nieznane zadanie."

#: src/Admin/Page.php:188
msgid "Small, audited replacements for single-purpose plugins. Every module is a switch. Features that Wordfence or wp-config already handle are skipped automatically."
msgstr "Małe, sprawdzone zamienniki jednozadaniowych wtyczek. Każdy moduł włączasz osobno. Funkcje, które obsługuje już Wordfence lub wp-config.php, są automatycznie pomijane."

#: src/Admin/Page.php:176
msgid "Settings are locked by WPHOUSE_LOCK_SETTINGS in wp-config.php. Change them in code."
msgstr "Ustawienia są zablokowane stałą WPHOUSE_LOCK_SETTINGS w wp-config.php. Zmieniaj je w kodzie."

#: src/Admin/Page.php:179
msgid "WPHOUSE_IGNORE_OVERLAPS is on: features run even where another plugin already provides them."
msgstr "Stała WPHOUSE_IGNORE_OVERLAPS jest włączona: funkcje działają nawet tam, gdzie zapewnia je już inna wtyczka."

#: src/Admin/Page.php:152
#: src/Admin/Page.php:204
msgid "General"
msgstr "Ogólne"

#: src/Admin/Page.php:207
msgid "Alert recipients"
msgstr "Odbiorcy alertów"

#: src/Admin/Page.php:210
msgid "Comma-separated. Empty means the site admin address."
msgstr "Adresy oddzielone przecinkami. Puste pole oznacza adres administratora witryny."

#: src/Admin/Page.php:263
msgid "Unavailable"
msgstr "Niedostępny"

#: src/Admin/Page.php:265
msgid "Running"
msgstr "Działa"

#: src/Admin/Page.php:267
msgid "Enabled, not running"
msgstr "Włączony, nie działa"

#: src/Admin/Page.php:269
msgid "Off"
msgstr "Wyłączony"

#: src/Admin/Page.php:286
msgid "Pinned by WPHOUSE_MODULES in wp-config.php."
msgstr "Ustawione na stałe przez WPHOUSE_MODULES w wp-config.php."

#. translators: %s: plugin or setting name, e.g. Wordfence.
#: src/Admin/Page.php:381
#, php-format
msgid "Handled by %s, skipped here."
msgstr "Obsługuje to %s, więc tutaj pominięte."

#: src/Admin/Page.php:503
msgid "Activity log"
msgstr "Dziennik zdarzeń"

#: src/Admin/Page.php:509
msgid "No events yet."
msgstr "Brak zdarzeń."

#: src/Admin/Page.php:281
#: src/Modules/Vulnerabilities.php:422
msgid "Details"
msgstr "Szczegóły"

#: src/Core/Updater.php:156
msgid "This WPHouse package is not listed in the signed release manifest. Update cancelled."
msgstr "Tej paczki WPHouse nie ma w podpisanym manifeście wydania. Aktualizacja anulowana."

#: src/Core/Updater.php:169
msgid "The downloaded WPHouse package does not match the signed checksum. Update cancelled."
msgstr "Pobrana paczka WPHouse nie zgadza się z podpisaną sumą kontrolną. Aktualizacja anulowana."

#: src/Modules/Duplicate.php:34
msgid "Duplicate posts and pages"
msgstr "Duplikowanie wpisów i stron"

#: src/Modules/Duplicate.php:38
msgid "Adds a \"Duplicate\" link to posts, pages and custom post types. The copy is a draft with the same content, taxonomies and custom fields. WooCommerce products use WooCommerce's own duplicate action."
msgstr "Dodaje link „Duplikuj” do wpisów, stron i własnych typów treści. Kopia to szkic z tą samą treścią, taksonomiami i polami własnymi. Produkty WooCommerce korzystają z własnej akcji duplikowania WooCommerce."

#: src/Modules/Duplicate.php:61
msgid "Duplicate"
msgstr "Duplikuj"

#: src/Modules/Duplicate.php:70
msgid "You are not allowed to duplicate this item."
msgstr "Nie masz uprawnień do zduplikowania tego elementu."

#. translators: %s: original title.
#: src/Modules/Duplicate.php:80
#, php-format
msgid "%s (copy)"
msgstr "%s (kopia)"

#: src/Modules/Hardening.php:74
msgid "Hardening"
msgstr "Podstawowe zabezpieczenia"

#: src/Modules/Hardening.php:85
msgid "Disable the theme/plugin file editor"
msgstr "Wyłącz edytor plików motywów i wtyczek"

#: src/Modules/Hardening.php:89
msgid "Block username discovery"
msgstr "Blokuj wykrywanie nazw użytkowników"

#: src/Modules/Hardening.php:90
msgid "For visitors who are not logged in: ?author=N scans, the REST users endpoint, the users sitemap and author data in oEmbed."
msgstr "Dla niezalogowanych odwiedzających: skanowanie ?author=N, endpoint użytkowników w REST API, mapa witryny użytkowników i dane autora w oEmbed."

#: src/Modules/Hardening.php:99
msgid "Generic login errors"
msgstr "Ogólne komunikaty błędów logowania"

#: src/Modules/Hardening.php:100
msgid "One message for a wrong username or a wrong password, on wp-login.php and the WooCommerce login form."
msgstr "Jeden komunikat przy błędnej nazwie użytkownika i przy błędnym haśle, na wp-login.php i w formularzu logowania WooCommerce."

#: src/Modules/Hardening.php:104
msgid "Hide the WordPress version"
msgstr "Ukryj wersję WordPressa"

#: src/Modules/Hardening.php:108
msgid "Disable XML-RPC"
msgstr "Wyłącz XML-RPC"

#: src/Modules/Hardening.php:109
msgid "xmlrpc.php answers 403. The WordPress mobile app and old desktop editors stop working with this site. Skipped automatically when Jetpack or WooPayments is active."
msgstr "xmlrpc.php odpowiada kodem 403. Aplikacja mobilna WordPress i starsze edytory desktopowe przestaną działać z tą witryną. Pomijane automatycznie, gdy aktywny jest Jetpack lub WooPayments."

#: src/Modules/Hardening.php:113
msgid "Basic security headers"
msgstr "Podstawowe nagłówki bezpieczeństwa"

#: src/Modules/Hardening.php:114
msgid "X-Content-Type-Options, Referrer-Policy and X-Frame-Options (same origin). Pages served from a full-page cache may not get them."
msgstr "X-Content-Type-Options, Referrer-Policy i X-Frame-Options (ta sama domena). Strony serwowane z pełnej pamięci podręcznej mogą ich nie dostać."

#: src/Modules/Hardening.php:118
msgid "HSTS (1 year, this domain only)"
msgstr "HSTS (1 rok, tylko ta domena)"

#: src/Modules/Hardening.php:119
msgid "Only on HTTPS. Browsers will refuse plain HTTP for a year, so turn it on only when HTTPS works everywhere on this domain."
msgstr "Tylko przez HTTPS. Przeglądarki przez rok będą odrzucać zwykłe HTTP, więc włącz to dopiero, gdy HTTPS działa w całej domenie."

#: src/Modules/Hardening.php:189
msgid "Sorry, you are not allowed to list users."
msgstr "Nie masz uprawnień do wyświetlania listy użytkowników."

#: src/Modules/Hardening.php:306
msgid "<strong>Error:</strong> The username, email address or password is incorrect."
msgstr "<strong>Błąd:</strong> nazwa użytkownika, adres e-mail lub hasło są nieprawidłowe."

#: src/Modules/Lockdown.php:40
msgid "Install lockdown"
msgstr "Blokada instalacji"

#: src/Modules/Lockdown.php:44
msgid "Nobody can install new plugins or themes or upload ZIP files, not even through a vulnerable plugin that skips permission checks. Updates keep working. Unlock for 30 minutes when you need to install something."
msgstr "Nikt nie zainstaluje nowych wtyczek ani motywów ani nie wgra plików ZIP, nawet przez podatną wtyczkę, która pomija sprawdzanie uprawnień. Aktualizacje działają normalnie. Gdy trzeba coś zainstalować, odblokuj instalację na 30 minut."

#: src/Modules/Lockdown.php:56
msgid "DISALLOW_FILE_MODS in wp-config.php already blocks all installs and updates."
msgstr "Stała DISALLOW_FILE_MODS w wp-config.php już blokuje wszystkie instalacje i aktualizacje."

#: src/Modules/Lockdown.php:100
msgid "Installing plugins and themes is locked by WPHouse. Unlock it first (WPHouse in the admin menu or `wp wphouse unlock`)."
msgstr "Instalowanie wtyczek i motywów jest zablokowane przez WPHouse. Najpierw je odblokuj (WPHouse w menu kokpitu lub `wp wphouse unlock`)."

#: src/Modules/Lockdown.php:122
msgid "Lock now"
msgstr "Zablokuj teraz"

#: src/Modules/Lockdown.php:127
msgid "Unlock installs for 30 minutes"
msgstr "Odblokuj instalację na 30 minut"

#: src/Modules/Lockdown.php:133
msgid "Installs are unlocked for 30 minutes."
msgstr "Instalacja jest odblokowana na 30 minut."

#: src/Modules/Lockdown.php:136
msgid "Installs are locked."
msgstr "Instalacja jest zablokowana."

#. translators: %s: time, e.g. 14:35
#: src/Modules/Lockdown.php:144
#, php-format
msgid "Unlocked until %s."
msgstr "Odblokowane do %s."

#: src/Modules/Lockdown.php:146
msgid "Locked. Updates of installed plugins, themes and core still work."
msgstr "Zablokowane. Aktualizacje zainstalowanych wtyczek, motywów i WordPressa nadal działają."

#: src/Modules/Maintenance.php:40
msgid "Maintenance mode"
msgstr "Tryb serwisowy"

#: src/Modules/Maintenance.php:44
msgid "Visitors see a short \"back soon\" page with HTTP 503, which search engines understand as temporary. Logged-in staff see the normal site. Payment callbacks, the REST API and cron keep working."
msgstr "Odwiedzający widzą krótką stronę „Zaraz wracamy” z kodem HTTP 503, który wyszukiwarki rozumieją jako przerwę tymczasową. Zalogowani pracownicy widzą normalną witrynę. Powiadomienia z bramek płatności, REST API i cron działają dalej."

#: src/Modules/Maintenance.php:51
msgid "Headline"
msgstr "Nagłówek"

#: src/Modules/Maintenance.php:52
msgid "Empty: \"We will be back soon\"."
msgstr "Puste pole: „Zaraz wracamy”."

#: src/Modules/Maintenance.php:57
msgid "Message"
msgstr "Wiadomość"

#: src/Modules/Maintenance.php:58
msgid "Basic HTML allowed (links, bold, line breaks)."
msgstr "Dozwolony prosty HTML (linki, pogrubienie, nowe linie)."

#: src/Modules/Maintenance.php:63
msgid "Expected duration (minutes)"
msgstr "Przewidywany czas (minuty)"

#: src/Modules/Maintenance.php:64
msgid "Sent to search engines as Retry-After."
msgstr "Przekazywany wyszukiwarkom w nagłówku Retry-After."

#: src/Modules/Maintenance.php:70
msgid "Who sees the normal site"
msgstr "Kto widzi normalną witrynę"

#: src/Modules/Maintenance.php:72
msgid "Administrators"
msgstr "Administratorzy"

#: src/Modules/Maintenance.php:73
msgid "Anyone who can edit content"
msgstr "Każdy, kto może edytować treści"

#: src/Modules/Maintenance.php:74
msgid "Every logged-in user"
msgstr "Każdy zalogowany użytkownik"

#: src/Modules/Maintenance.php:111
msgid "We will be back soon"
msgstr "Zaraz wracamy"

#: src/Modules/Maintenance.php:149
msgid "Maintenance mode is on"
msgstr "Tryb serwisowy jest włączony"

#: src/Modules/PluginHealth.php:111
msgid "Plugin health"
msgstr "Kondycja wtyczek"

#: src/Modules/PluginHealth.php:115
msgid "Weekly check of installed plugins: closed on WordPress.org (often for security reasons), no update for two years, not from WordPress.org, one-time tools left active, inactive leftovers, and plugins a WPHouse module replaces. Results also appear in Tools → Site Health."
msgstr "Cotygodniowy przegląd zainstalowanych wtyczek: zamknięte na WordPress.org (często z powodów bezpieczeństwa), bez aktualizacji od dwóch lat, spoza WordPress.org, jednorazowe narzędzia pozostawione jako aktywne, nieaktywne pozostałości oraz wtyczki, które zastępuje moduł WPHouse. Wyniki widać też w Narzędzia → Stan witryny."

#: src/Modules/PluginHealth.php:239
msgid "Inactive. Inactive plugins can still be attacked through their files; delete it if you do not need it."
msgstr "Nieaktywna. Nieaktywne wtyczki nadal można zaatakować przez ich pliki; usuń ją, jeśli nie jest potrzebna."

#. translators: 1: date, 2: reason code from WordPress.org, e.g. security-issue.
#: src/Modules/PluginHealth.php:266
#, php-format
msgid "Closed on WordPress.org (%1$s, reason: %2$s). It gets no more updates; replace or remove it."
msgstr "Zamknięta na WordPress.org (%1$s, powód: %2$s). Nie dostanie już aktualizacji; zastąp ją albo usuń."

#. translators: %s: date of the last update.
#: src/Modules/PluginHealth.php:272
#, php-format
msgid "No update since %s. Probably abandoned."
msgstr "Brak aktualizacji od %s. Prawdopodobnie porzucona."

#: src/Modules/PluginHealth.php:277
msgid "Not on WordPress.org and no update source declared. Make sure you know where its updates come from."
msgstr "Nie ma jej na WordPress.org i nie deklaruje źródła aktualizacji. Upewnij się, skąd przychodzą jej aktualizacje."

#: src/Modules/PluginHealth.php:282
msgid "Updates come from its vendor, not WordPress.org. Keep the licence active so security fixes arrive."
msgstr "Aktualizacje przychodzą od producenta, nie z WordPress.org. Utrzymuj aktywną licencję, żeby docierały poprawki bezpieczeństwa."

#: src/Modules/PluginHealth.php:287
msgid "One-time tool (migration, search-replace, import, file access or debugging) left active. Delete it when the job is done."
msgstr "Jednorazowe narzędzie (migracja, wyszukaj-i-zamień, import, dostęp do plików lub debugowanie) pozostawione jako aktywne. Usuń je po zakończeniu pracy."

#. translators: %s: WPHouse module name.
#: src/Modules/PluginHealth.php:294
#, php-format
msgid "WPHouse can do this: module \"%s\". Switch it on, then remove this plugin."
msgstr "WPHouse to potrafi: moduł „%s”. Włącz go, a potem usuń tę wtyczkę."

#: src/Modules/PluginHealth.php:318
msgid "WPHouse plugin health"
msgstr "Kondycja wtyczek (WPHouse)"

#: src/Modules/PluginHealth.php:339
msgid "No closed, abandoned or forgotten plugins found"
msgstr "Nie znaleziono zamkniętych, porzuconych ani zapomnianych wtyczek"

#: src/Modules/PluginHealth.php:340
msgid "Some plugins need attention"
msgstr "Niektóre wtyczki wymagają uwagi"

#: src/Core/Net.php:155
#: src/Modules/Hardening.php:270
#: src/Modules/LoginLimits.php:354
#: src/Modules/PluginHealth.php:345

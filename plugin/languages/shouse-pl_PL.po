msgstr "Krytyczne: %1$d, ostrzeżenia: %2$d. Szczegóły na stronie ustawień SafeHouse."

#: src/Modules/PluginHealth.php:367
msgid "Open SafeHouse"
msgstr "Otwórz SafeHouse"

#: src/Modules/PluginHealth.php:373
#: src/Modules/Vulnerabilities.php:329
